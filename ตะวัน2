-- โหมดที่ 1: หมุน 360 องศา
local spinning = false
local spinSpeed = 25

SpinToggle.MouseButton1Click:Connect(function()
    spinning = not spinning
    if spinning then
        SpinToggle.Text = "โหมด 1: หมุน 360 องศา [เปิด]"
        SpinToggle.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    else
        SpinToggle.Text = "โหมด 1: หมุน 360 องศา [ปิด]"
        SpinToggle.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    end
end)

game:GetService("RunService").RenderStepped:Connect(function()
    if spinning then
        local player = game.Players.LocalPlayer
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(spinSpeed), 0)
        end
    end
end)

-- โหมดที่ 2: ฟังก์ชันบินไปหาไข่ด้วยความเร็ว 800
local flySpeed = 800

local function flyToLocation(targetCFrame)
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    local distance = (targetCFrame.Position - hrp.Position).Magnitude
    local duration = distance / flySpeed
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = game:GetService("TweenService"):Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
end

-- ระบบค้นหาวัตถุไข่ในแมพและบินไปหา
StealEggBtn.MouseButton1Click:Connect(function()
    local targetEgg = nil
    
    -- ค้นหาวัตถุใน Workspace ที่มีคำว่า "Egg"
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            if string.find(string.lower(obj.Name), "egg") then
                targetEgg = obj
                break
            end
        end
    end
    
    if targetEgg then
        StealEggBtn.Text = "กำลังบินไปขโมยไข่..."
        StealEggBtn.BackgroundColor3 = Color3.fromRGB(255, 170, 0)
        
        local eggCFrame = targetEgg:IsA("Model") and targetEgg:GetPivot() or targetEgg.CFrame
        flyToLocation(eggCFrame)
        
        task.wait(1.5)
        StealEggBtn.Text = "โหมด 2: บินไปขโมยไข่ (Speed 800)"
        StealEggBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    else
        StealEggBtn.Text = "ไม่พบไข่ในบริเวณนี้!"
        StealEggBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        task.wait(1.5)
        StealEggBtn.Text = "โหมด 2: บินไปขโมยไข่ (Speed 800)"
        StealEggBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    end
end)
